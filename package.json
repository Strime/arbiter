{
  "name": "arbiter",
  "description": "Extension navigateur qui affiche l'origine (marque + fabrication) des produits sur les drives français",
  "private": true,
  "version": "0.1.2",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "npm run zip && npm run zip:firefox",
    "submit": "wxt submit --chrome-zip output/$npm_package_name-$npm_package_version-chrome.zip --firefox-zip output/$npm_package_name-$npm_package_version-firefox.zip --firefox-sources-zip output/$npm_package_name-$npm_package_version-sources.zip",
    "submit:chrome": "wxt submit --chrome-zip output/$npm_package_name-$npm_package_version-chrome.zip",
    "submit:firefox": "wxt submit --firefox-zip output/$npm_package_name-$npm_package_version-firefox.zip --firefox-sources-zip output/$npm_package_name-$npm_package_version-sources.zip",
    "submit:dry": "npm run submit -- --dry-run",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:brands": "node scripts/measurements/eval-accuracy.mjs",
    "e2e": "node scripts/e2e/smoke.mjs",
    "build:brands": "node scripts/build-brands-db.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "happy-dom": "^20.11.2",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wxt": "^0.20.26"
  }
}
